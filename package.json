{
  "name": "megalopolis-api",
  "version": "1.0.0",
  "description": "Modular monolith API aggregator for a personal dashboard",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "start": "NODE_ENV=production node dist/server.js"
  },
  "keywords": [
    "express",
    "api",
    "dashboard",
    "aggregator"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.18.0",
    "typescript": "^5.5.4"
  }
}
